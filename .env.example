# Required: WooCommerce WPGraphQL endpoint
GQL_HOST=https://your-wordpress-site.com/graphql

# Required: Your frontend URL (used as Origin header for WPGraphQL CORS)
APP_HOST=https://your-coconut-shop.com

# Required: domains of images served from WordPress (for @nuxt/image)
NUXT_IMAGE_DOMAINS=your-wordpress-site.com

# Optional: ISR cache TTL in seconds for product pages (default: 3600)
CATALOG_ISR_TTL=3600

# Optional: Stripe publishable key (for Stripe checkout)
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
